# Copy to deploy/.env (ignored by git) and replace every placeholder with a
# long random value, for example the output of `openssl rand -base64 33`.
# Compose refuses to start while any of these is missing or empty. Never
# commit the real file.
POSTGRES_PASSWORD=change-me-postgres
REDIS_PASSWORD=change-me-redis
SERVERPOD_SERVICE_SECRET=change-me-service-secret

# Optional organisation tree: corporation:<id>, alliance:<id>, or coalition:<id>,<id>.
# Unset or empty leaves the tree unconfigured.
# KANAME_ORG_TREE=alliance:99000001

# Optional server EVE SSO. See deploy/README.md for registration and local testing.
# KANAME_ESI_SSO_CLIENT_ID=
# KANAME_ESI_SSO_CLIENT_SECRET=
# KANAME_ESI_SSO_REDIRECT_URI=http://localhost/auth/esi/callback
# KANAME_ESI_SSO_ALLOW_LOCAL_HTTP=true
# KANAME_ESI_VAULT_KEY=
# KANAME_ESI_SCOPE_POLICY='{"revision":1,"enabledModules":["personalSkills"],"classes":{"characterSkills":"required"}}'
# KANAME_ESI_SSO_ADMIN_CHARACTERS=
