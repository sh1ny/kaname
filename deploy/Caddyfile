# Caddy for the local self-host stack (design D2, D12, S3): plain HTTP on :80,
# published on 127.0.0.1 only by compose.yaml. No TLS until a deployment guide.
{
	# Client addresses (C6). Caddy trusts no forwarded header: it sets
	# X-Forwarded-For to the address each connection came from, and the
	# server trusts only Caddy's fixed address (compose.yaml). Caddy is meant
	# to be a public deployment's edge. Every trusted proxy must append the
	# address it received the connection from; one that passes a caller's
	# header through must not be trusted. A proxy or tunnel in front of Caddy
	# makes the server receive the chain "client, front proxy", so both hops
	# must be trusted: the front proxy's address goes into trusted_proxies
	# here and into the server's KANAME_TRUSTED_PROXIES beside Caddy's. The
	# shipped stack stays Caddy-only. The front proxy needs a fixed address
	# on the stack network, outside the dynamic range and distinct from
	# Caddy's and the gateway's; a separate Caddy port is not enough, because
	# this trust list applies to every listener, and trusting the Docker
	# gateway would trust every local caller. Otherwise every user shares one
	# bucket. The project ships no such topology: before trusting the proxy,
	# check that Caddy sees the proxy's own address as its peer, then, before
	# the route goes public, check end to end that a second client is still
	# served after a first fills its 16 places and that a forwarded header
	# from either changes neither bucket. Repeat both checks after any
	# network or address change (deploy/README.md).
	auto_https off
	admin off

	# A proxy failure can reach the runtime error log even when access
	# logging is disabled. Never include a browser's callback query.
	log {
		format filter {
			wrap json
			fields {
				request>uri delete
			}
		}
	}

	servers {
		timeouts {
			# Closes a connection whose client has stopped reading: a write
			# that makes no progress for this long aborts it, which frees the
			# bytes a stalled bundle download pins in the server (design D4,
			# C19). It is an idle limit, reset before every write, not a limit
			# on the whole response, so a slow but moving download and the
			# 30-minute announcement WebSockets (whose writes complete) are
			# not cut. Caddy's own default is 1m; it is set here so the
			# stack's behaviour does not follow a default.
			write_idle 1m
		}
	}
}

:80 {
	@sso path /auth/esi /auth/esi/*
	@private path /auth/esi /auth/esi/* /api/esiCallLog/* /api/staticDataAdmin/* /api/memberRoster /api/memberRoster/* /api/memberAccount /api/memberAccount/*
	log_skip @private
	handle @sso {
		reverse_proxy server:8080
	}

	# The API lives under /api/ on the web app's origin, with the prefix
	# removed before the server sees it. It never falls back to index.html:
	# an unknown path is the server's own not-found.
	handle_path /api/* {
		reverse_proxy server:8080
	}
	# The bare prefix is also the API's, never the web app's.
	handle /api {
		respond "Not Found" 404
	}

	# The generated client opens its WebSocket at /v1/websocket on the
	# origin, whatever path the app is configured with, so the web app's
	# streams (the static-data announcements) arrive here, not under /api/.
	# The path passes through unchanged; without this route they would get
	# the single-page-app fallback.
	handle /v1/websocket {
		reverse_proxy server:8080
	}

	# Health probes pass through unchanged.
	@probes path /livez /readyz
	handle @probes {
		reverse_proxy server:8080
	}

	# The web app loads fallback fonts from this path, an empty address on its
	# own origin (never a Google host): the engine asks here for glyphs that the
	# bundled fonts do not cover and gets a plain 404, not the single-page-app
	# fallback.
	# The path must match fontFallbackBaseUrl in app/web/flutter_bootstrap.js;
	# change one, change the other.
	@fontFallback path /font-fallback /font-fallback/*
	handle @fontFallback {
		respond "Not Found" 404
	}

	# Everything else is the web build, with the single-page-app fallback.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
