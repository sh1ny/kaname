# Build context for deploy/server.Dockerfile (Docker reads this file instead of
# a root .dockerignore, and ignores .gitignore). Deny everything, then admit
# only what the image build copies.
**

!mise.toml
!mise.lock
!pubspec.yaml
!pubspec.lock

# Workspace members: pubspecs only, to resolve the whole workspace.
!app/pubspec.yaml
!app_packages/kaname_ember_ui/pubspec.yaml
!packages/kaname_core/pubspec.yaml
!packages/kaname_esi/pubspec.yaml
!packages/kaname_static_data/pubspec.yaml
!packages/kaname_static_data_bundle/pubspec.yaml
!spikes/kaname_grid_spike/pubspec.yaml
!tools/kaname_tools/pubspec.yaml

# The server packages' sources, and the workspace packages the server imports.
!packages/kaname_core/lib/**
!packages/kaname_static_data/lib/**
!packages/kaname_static_data_bundle/lib/**
!server/kaname_client/pubspec.yaml
!server/kaname_client/lib/**
!server/kaname_server/pubspec.yaml
!server/kaname_server/bin/**
!server/kaname_server/lib/**
!server/kaname_server/config/**
!server/kaname_server/migrations/**

# Never in the image, whatever the allow-list above admits: secrets, local
# environment files and Serverpod's generated state.
**/config/passwords*.yaml
**/.env*
**/.serverpod/
