{
  "mcpServers": {
    "dart": {
      "type": "stdio",
      "command": "mise",
      "args": ["exec", "--", "dart", "mcp-server", "--enable", "cli", "--enable", "flutter_app_lifecycle"]
    },
    "context7": {
      "type": "stdio",
      "command": "mise",
      "args": ["exec", "--", "npx", "-y", "@upstash/context7-mcp"]
    },
    "serverpod": {
      "type": "stdio",
      "command": "mise",
      "args": ["exec", "-C", "server/kaname_server", "--", "dart", "run", "serverpod_cli", "mcp-server", "--server-dir", "."]
    }
  }
}
